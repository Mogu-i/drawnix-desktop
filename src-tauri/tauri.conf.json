{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Sihua",
  "version": "0.1.1",
  "identifier": "sihua",
  "build": {
    "frontendDist": "../dist/apps/web",
    "devUrl": "http://localhost:7200",
    "beforeDevCommand": "npx nx serve web",
    "beforeBuildCommand": "npx nx build web"
  },
  "app": {
    "windows": [
      {
        "title": "思画",
        "width": 1200,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
